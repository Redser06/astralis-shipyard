# Copy to .env.local and fill in. .env.local is gitignored.
#
# SERVER-SIDE ONLY. This key is read by the Vite dev server's Node process and
# by whatever function runtime you deploy server/architect.ts to. It is never
# passed through `define`, never prefixed with VITE_, and never reaches the
# browser bundle — `npm run verify:bundle` fails the build if it ever does.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5.
ARCHITECT_MODEL=claude-sonnet-5
